# Safe defaults for the release ZIP. Replace the password before starting.
REMOTE_PASSWORD=replace-with-a-long-random-password

# The default workspace is the directory containing this release.
WORKSPACE_ROOT=.

# Keep the service private by default.
HOST=127.0.0.1
PORT=8787
COOKIE_SECURE=0
TRUST_PROXY=0

# Codex can edit only WORKSPACE_ROOT after an approved turn.
CODEX_SANDBOX=workspace-write
ENABLE_DESKTOP_SESSION_HISTORY=1

# Configure OPENAI_API_KEY, CODEX_HOME, CODEX_COMMAND, and PUBLIC_ORIGIN locally when needed.
